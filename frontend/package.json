{
  "name": "thruflux-frontend",
  "version": "0.4.0-beta",
  "author": {
    "name": "infiniteplayapps",
    "email": "infiniteplayapps@gmail.com"
  },
  "description": "Thruflux",
  "main": "dist/main/main.js",
  "homepage": "https://thruflux.bytepipe.app/",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/main.tsx --bundle --platform=browser --format=iife --sourcemap --jsx=automatic --outfile=dist/renderer/renderer.js",
    "copy:renderer": "node scripts/copy-renderer.mjs",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "publishLandingPage": "node scripts/publish-landing-page.mjs"
  },
  "build": {
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries"
      }
    ],
    "appId": "app.thruflux.desktop",
    "productName": "Thruflux",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icons/icons/mac/icon.icns",
      "artifactName": "Thruflux-macos-universal.${ext}",
      "x64ArchFiles": "Contents/Resources/binaries/macos/thru_mac",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "pkg": {
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": false,
      "installLocation": "/Applications",
      "scripts": "pkg-scripts"
    },
    "win": {
      "icon": "build/icons/icons/win/icon.ico",
      "artifactName": "Thruflux-windows-amd64.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/windows/installer.nsh"
    },
    "linux": {
      "icon": "build/icons/icons/png/512x512.png",
      "artifactName": "Thruflux-linux-amd64.${ext}",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "afterInstall": "build/linux/deb-after-install.sh"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}

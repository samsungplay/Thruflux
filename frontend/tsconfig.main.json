{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/common/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
